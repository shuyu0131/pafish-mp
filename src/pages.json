{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^t-(.*)": "@tdesign/uniapp/$1/$1.vue",
      "^zz-(.*)": "@/components/zz-$1/zz-$1.vue"
    }
  },
  "pages": [
    { "path": "pages/index/index",    "style": { "navigationBarTitleText": "纸鱼博客", "enablePullDownRefresh": true } },
    { "path": "pages/micro/index",    "style": { "navigationBarTitleText": "微语", "enablePullDownRefresh": true } },
    { "path": "pages/mine/index",     "style": { "navigationBarTitleText": "我的" } },
    { "path": "pages/search/index",   "style": { "navigationBarTitleText": "搜索" } },
    { "path": "pages/post/detail",    "style": { "navigationBarTitleText": "文章" } },
    { "path": "pages/mine/favorites", "style": { "navigationBarTitleText": "我的收藏" } },
    { "path": "pages/mine/comments",  "style": { "navigationBarTitleText": "我的评论" } },
    { "path": "pages/mine/history",   "style": { "navigationBarTitleText": "浏览历史" } },
    { "path": "pages/settings/index", "style": { "navigationBarTitleText": "设置" } },
    { "path": "pages/settings/about", "style": { "navigationBarTitleText": "关于" } }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "纸鱼博客",
    "navigationBarBackgroundColor": "#ffffff",
    "backgroundColor": "#ffffff"
  }
}
