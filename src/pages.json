{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^t-(.*)": "@tdesign/uniapp/$1/$1.vue",
      "^zz-(.*)": "@/components/zz-$1/zz-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "纸鱼博客",
        "navigationStyle": "custom",
        "navigationBarTextStyle": "black",
        "navigationBarBackgroundColor": "#beebff",
        "backgroundColor": "#f5f7fa",
        "backgroundTextStyle": "dark",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/micro/index",
      "style": {
        "navigationBarTitleText": "微语",
        "navigationStyle": "custom",
        "navigationBarTextStyle": "black",
        "navigationBarBackgroundColor": "#f5f7fa",
        "backgroundColor": "#f5f7fa",
        "backgroundTextStyle": "dark",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/mine/index",
      "style": {
        "navigationBarTitleText": "我的",
        "navigationStyle": "custom",
        "navigationBarTextStyle": "white",
        "navigationBarBackgroundColor": "#1b2836",
        "backgroundColor": "#f5f7fa"
      }
    },
    {
      "path": "pages/category/index",
      "style": {
        "navigationBarTitleText": "分类",
        "navigationStyle": "custom",
        "navigationBarTextStyle": "black",
        "navigationBarBackgroundColor": "#f5f7fa",
        "backgroundColor": "#f5f7fa",
        "backgroundTextStyle": "dark"
      }
    },
    {
      "path": "pages/post/detail",
      "style": {
        "navigationBarTitleText": "文章",
        "navigationStyle": "custom",
        "navigationBarTextStyle": "white",
        "navigationBarBackgroundColor": "#1b2836",
        "backgroundColor": "#f5f7fa"
      }
    },
    { "path": "pages/mine/favorites", "style": { "navigationBarTitleText": "我的收藏", "backgroundColor": "#f5f7fa" } },
    { "path": "pages/mine/comments", "style": { "navigationBarTitleText": "我的评论", "backgroundColor": "#f5f7fa" } },
    { "path": "pages/mine/history", "style": { "navigationBarTitleText": "浏览历史", "backgroundColor": "#f5f7fa" } },
    { "path": "pages/settings/index", "style": { "navigationBarTitleText": "设置", "backgroundColor": "#f5f7fa" } },
    { "path": "pages/settings/about", "style": { "navigationBarTitleText": "关于", "backgroundColor": "#f5f7fa" } }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "纸鱼博客",
    "navigationBarBackgroundColor": "#f5f7fa",
    "backgroundColor": "#f5f7fa",
    "backgroundTextStyle": "dark",
    "onReachBottomDistance": 120
  }
}
